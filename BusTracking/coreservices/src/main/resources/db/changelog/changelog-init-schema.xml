<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="ddl_create_tables" author="you">
        <!--  advertising_banner table  -->
        <!--  alert table  -->
        <createTable tableName="alert">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_ALERT_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="alert_time" type="timestamp"/>
            <column name="seen" type="boolean"/>
            <column name="trip_back" type="boolean"/>
            <column name="alert_flag_id_ref" type="bigint"/>
            <column name="line_id_ref" type="bigint"/>
            <column name="bus_id_ref" type="bigint"/>
        </createTable>
        <!--  alert_flag table  -->
        <createTable tableName="alert_flag">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_ALERT_FLAG_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="label_fr" type="varchar(255)"/>
            <column name="label_ar" type="varchar(255)"/>
        </createTable>
        <!--  bus table  -->
        <createTable tableName="bus">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_BUS_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="registration_plate" type="varchar(255)"/>
            <column name="active" type="boolean"/>
            <column name="headsign_id_ref" type="bigint"/>
            <column name="tracking_device_id_ref" type="varchar(255)"/>
        </createTable>
        <!--  company table  -->
        <!--  daily_timetable table  -->
        <!--  day_flag_ar table  -->
        <createTable tableName="day_flag_ar">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_DAY_FLAG_AR_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)"/>
        </createTable>
        <!--  day_flag_fr table  -->
        <createTable tableName="day_flag_fr">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_DAY_FLAG_FR_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="label" type="varchar(255)"/>
        </createTable>
        <!--  day_of_year table  -->
        <createTable tableName="day_of_year">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_DAY_OF_YEAR_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="day" type="date"/>
            <column name="day_flag_ar_id_ref" type="bigint"/>
            <column name="day_flag_fr_id_ref" type="bigint"/>
        </createTable>
        <!--  event table  -->
        <!--  event_flag table  -->
        <!--  feedback table  -->
        <!--  headsign table  -->
        <createTable tableName="headsign">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_HEADSIGN_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="serial_number" type="varchar(255)"/>
            <column name="model" type="varchar(255)"/>
        </createTable>
        <!--  itinerary_datamatrix table  -->
        <!--  itinerary table  -->
        <!--  itinerary_override table  -->
        <!--  itinerary_stop_time table  -->
        <!--  line table  -->
        <createTable tableName="line">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_LINE_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="arabic_code" type="varchar(255)"/>
            <column name="arabic_description" type="varchar(255)"/>
            <column name="latin_code" type="varchar(255)"/>
            <column name="latin_description" type="varchar(255)"/>
            <column name="color" type="varchar(255)"/>
        </createTable>
        <!--  location table  -->
        <!--  location_history table  -->
        <!--  notification_alert table  -->
        <!--  notification_event table  -->
        <!--  stat_counter table  -->
        <!--  stop table  -->
        <createTable tableName="stop">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="CPK_STOP_TABLE"/>
            </column>
            <column name="uuid" type="varchar(255)" remarks="uuid">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="etag" type="int" remarks="Aggregate version">
                <constraints nullable="false"/>
            </column>
            <column name="stop_code" type="varchar(255)"/>
            <column name="arabic_name" type="varchar(255)"/>
            <column name="latin_name" type="varchar(255)"/>
            <column name="latitude" type="double precision"/>
            <column name="longitude" type="double precision"/>
            <column name="trip_back" type="boolean"/>
        </createTable>
        <!--  timetable table  -->
        <!--  tracking_device table  -->
        <!--  trip table  -->
        <!--  trip_history table  -->
        <!--  trip_planning table  -->
        <!--  version table  -->
        <!--  volatile_location table  -->
        <addForeignKeyConstraint baseColumnNames="alert_flag_id_ref" baseTableName="alert" constraintName="fk_alert_flag_id_ref" referencedColumnNames="id" referencedTableName="alert_flag"/>
        <addForeignKeyConstraint baseColumnNames="line_id_ref" baseTableName="alert" constraintName="fk_line_id_ref" referencedColumnNames="id" referencedTableName="line"/>
        <addForeignKeyConstraint baseColumnNames="bus_id_ref" baseTableName="alert" constraintName="fk_bus_id_ref" referencedColumnNames="id" referencedTableName="bus"/>
        <addForeignKeyConstraint baseColumnNames="headsign_id_ref" baseTableName="bus" constraintName="headsign_id_fk" referencedColumnNames="id" referencedTableName="headsign"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_ar_id_ref" baseTableName="day_of_year" constraintName="day_of_year_day_flag_ar_id_ref_fk" referencedColumnNames="id" referencedTableName="day_flag_ar"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_fr_id_ref" baseTableName="day_of_year" constraintName="day_of_year_day_flag_fr_id_ref_fk" referencedColumnNames="id" referencedTableName="day_flag_fr"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_ar_id" baseTableName="itinerary_datamatrix" constraintName="day_flag_ar_id_fk" referencedColumnNames="id" referencedTableName="day_flag_ar"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_fr_id" baseTableName="itinerary_datamatrix" constraintName="day_flag_fr_id_fk" referencedColumnNames="id" referencedTableName="day_flag_fr"/>
        <addForeignKeyConstraint baseColumnNames="line_id_ref" baseTableName="itinerary_datamatrix" constraintName="itinerary_datamatrix_line_id_ref_fk" referencedColumnNames="id" referencedTableName="line"/>
        <addForeignKeyConstraint baseColumnNames="stop_id_ref" baseTableName="itinerary_datamatrix" constraintName="itinerary_datamatrix_stop_id_ref_fk" referencedColumnNames="id" referencedTableName="stop"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_ar_id_ref" baseTableName="itinerary" constraintName="itinerary_day_flag_ar_id_ref_fk" referencedColumnNames="id" referencedTableName="day_flag_ar"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_fr_id_ref" baseTableName="itinerary" constraintName="itinerary_day_flag_fr_id_ref_fk" referencedColumnNames="id" referencedTableName="day_flag_fr"/>
        <addForeignKeyConstraint baseColumnNames="line_id_ref" baseTableName="itinerary" constraintName="itinerary_line_id_ref_fk" referencedColumnNames="id" referencedTableName="line"/>
        <addForeignKeyConstraint baseColumnNames="stop_id_ref" baseTableName="itinerary" constraintName="itinerary_stop_id_ref_fk" referencedColumnNames="id" referencedTableName="stop"/>
        <addForeignKeyConstraint baseColumnNames="bus_id_ref" baseTableName="itinerary_override" constraintName="itinerary_override_bus_id_ref_fk" referencedColumnNames="id" referencedTableName="bus"/>
        <addForeignKeyConstraint baseColumnNames="alert_flag_id_ref" baseTableName="location" constraintName="alert_flag_id_ref_fk" referencedColumnNames="id" referencedTableName="alert_flag"/>
        <addForeignKeyConstraint baseColumnNames="line_id_ref" baseTableName="location" constraintName="location_line_id_ref_fk" referencedColumnNames="id" referencedTableName="line"/>
        <addForeignKeyConstraint baseColumnNames="stop_id_ref" baseTableName="location" constraintName="location_stop_id_ref_fk" referencedColumnNames="id" referencedTableName="stop"/>
        <addForeignKeyConstraint baseColumnNames="bus_id_ref" baseTableName="location" constraintName="location_bus_id_ref_fk" referencedColumnNames="id" referencedTableName="bus"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_ar_id_ref" baseTableName="timetable" constraintName="timetable_day_flag_ar_id_ref_fk" referencedColumnNames="id" referencedTableName="day_flag_ar"/>
        <addForeignKeyConstraint baseColumnNames="day_flag_fr_id_ref" baseTableName="timetable" constraintName="timetable_day_flag_fr_id_ref_fk" referencedColumnNames="id" referencedTableName="day_flag_fr"/>
        <addForeignKeyConstraint baseColumnNames="line_id_ref" baseTableName="timetable" constraintName="timetable_line_id_ref_fk" referencedColumnNames="id" referencedTableName="line"/>
        <addForeignKeyConstraint baseColumnNames="bus_id_ref" baseTableName="trip" constraintName="trip_bus_id_ref_fk" referencedColumnNames="id" referencedTableName="bus"/>
        <addForeignKeyConstraint baseColumnNames="timetable_id_ref" baseTableName="trip" constraintName="trip_timetable_id_ref_fk" referencedColumnNames="id" referencedTableName="timetable"/>
    </changeSet>
    <changeSet id="ddl_add_sequences" author="actitrip">
        <createSequence sequenceName="ALERT_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="ALERT_FLAG_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="BUS_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="DAY_FLAG_AR_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="DAY_FLAG_FR_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="DAY_OF_YEAR_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="HEADSIGN_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="LINE_ID_SEQ" startValue="101" incrementBy="50"/>
        <createSequence sequenceName="STOP_ID_SEQ" startValue="101" incrementBy="50"/>
    </changeSet>
</databaseChangeLog>